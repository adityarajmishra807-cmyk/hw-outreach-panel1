# Server-side Gemini credentials. Configure the real value in Vercel Environment Variables.
GEMINI_KEY=
# Optional model override. The API route defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Persistent Horizon Memory uses an Upstash Redis store connected to Vercel.
# Vercel/Upstash injects these variables when the storage integration is connected.
KV_REST_API_URL=
KV_REST_API_TOKEN=
